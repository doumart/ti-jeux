# Copy to .env. Never commit real secrets. Local preview (bun run activity:dev) needs none of these.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
# Your server's hostname (free: yourname.duckdns.org). Caddy gets the HTTPS certificate.
DOMAIN=tijeux.duckdns.org
PUBLIC_ORIGIN=https://tijeux.duckdns.org
# Optional: extra Discord user IDs allowed to host (the app's owner/team always can), comma-separated.
HOSTS=
